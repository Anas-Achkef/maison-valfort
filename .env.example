# ===================================
# CONFIGURATION MAISON VALFORT
# ===================================
# Copiez ce fichier en .env.local et remplissez les valeurs

# Google Analytics (optionnel)
# Créez un compte sur analytics.google.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Email pour les formulaires de contact
ADMIN_EMAIL=contact@maisonvalfort.com

# Resend API (pour l'envoi d'emails)
# Créez un compte sur resend.com
RESEND_API_KEY=re_xxxxxxxxxx

# URL du site (pour le sitemap et les emails)
NEXT_PUBLIC_SITE_URL=https://maisonvalfort.com

# Claude API (pour le chatbot - optionnel)
CLAUDE_API_KEY=sk-ant-api03-xxxxxxxxxx
